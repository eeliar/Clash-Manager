# Backend runtime configuration
DATABASE_URL=sqlite:////app/data/clashmanager.db
SECRET_KEY=replace-with-a-long-random-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password
SUBSCRIPTION_TOKEN=replace-with-a-long-random-token
PUBLIC_BASE_URL=http://127.0.0.1
SUBSCRIPTION_CACHE_MAX_AGE=300
CORS_ALLOW_ORIGINS=http://localhost,http://127.0.0.1
ENABLE_API_DOCS=false

# Optional Mihomo controller settings for advanced latency testing and generated config metadata.
# Leave blank unless you run Mihomo separately and want controller-backed delay checks.
# MIHOMO_EXTERNAL_CONTROLLER=127.0.0.1:9090
# MIHOMO_SECRET=replace-with-a-controller-secret
MIHOMO_CONTROLLER_URL=http://127.0.0.1:9090
MIHOMO_DELAY_TEST_URL=https://www.gstatic.com/generate_204
MIHOMO_DELAY_TIMEOUT_MS=5000
